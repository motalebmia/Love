<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>প্রেমের পেজ</title>
<style>
  /* Reset & Base */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    background: linear-gradient(160deg, #ff9a9e, #fad0c4, #fbc2eb);
    background-size: 400% 400%;
    animation: bgGradient 15s ease infinite;
  }

  /* Background gradient animation */
  @keyframes bgGradient {
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  /* Heart container */
  .heart-container {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Heart style */
  .heart {
    position: absolute;
    bottom: 0;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #fff;
    font-weight: bold;
    border-radius: 50%;
    padding: 10px;
    user-select: none;
    pointer-events: auto;
    animation: floatUp linear forwards;
  }

  @keyframes floatUp {
    0% { transform: translateY(0) scale(1); opacity: 1; }
    50% { transform: translateY(-50vh) scale(1.1); opacity: 0.9; }
    100% { transform: translateY(-120vh) scale(1.3); opacity: 0; }
  }

  /* Heart pulse */
  .heart {
    animation-name: floatUp, pulse;
    animation-iteration-count: 1, infinite;
    animation-timing-function: linear, ease-in-out;
  }

  @keyframes pulse {
    0% { transform: scale(1) rotate(0deg);}
    50% { transform: scale(1.2) rotate(5deg);}
    100% { transform: scale(1) rotate(-5deg);}
  }

  /* Blast effect */
  .blast {
    animation: explode 0.5s forwards;
  }

  @keyframes explode {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  /* Bottom love text */
  .love-text {
    position: relative;
    z-index: 10;
    width: 90%;
    max-width: 500px;
    background: rgba(255,255,255,0.15);
    padding: 20px;
    border-radius: 25px;
    text-align: center;
    color: #fff;
    font-size: 18px;
    margin-bottom: 20px;
    backdrop-filter: blur(10px);
    animation: fadeInText 2s ease forwards;
    line-height: 1.6;
  }

  @keyframes fadeInText {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
</head>
<body>

<div class="heart-container"></div>

<div class="love-text">
  নাজমিন এবং মোতালেবের ভালোবাসা অনন্ত।<br>
  প্রতিটি মুহূর্ত তাদের জন্য আনন্দ এবং একে অপরের প্রতি শ্রদ্ধা ও যত্নের সাক্ষী।<br>
  সত্যিকারের ভালোবাসা হলো একে অপরকে বোঝা, সম্মান করা এবং প্রতিদিনকে আরও সুন্দর করে তোলা।
</div>

<script>
  const heartContainer = document.querySelector('.heart-container');

  const names = ["নাজমিন", "মোতালেব"];
  const colors = ["#ff4d6d", "#ff6f91", "#ff9671", "#ffc75f", "#f9f871"];
  const sizes = [20, 25, 30, 35, 40, 45, 50];

  function createHeart() {
    const heart = document.createElement('div');
    heart.classList.add('heart');

    // Random Name inside heart
    heart.textContent = Math.random() < 0.7 ? names[0] : names[1];

    // Random background color
    heart.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];

    // Random size
    const size = sizes[Math.floor(Math.random() * sizes.length)];
    heart.style.fontSize = `${size}px`;
    heart.style.width = `${size*2}px`;
    heart.style.height = `${size*2}px`;
    heart.style.lineHeight = `${size*2}px`;

    // Random horizontal position
    heart.style.left = Math.random() * 90 + 'vw';

    // Random animation duration
    heart.style.animationDuration = (5 + Math.random() * 5) + 's, 2s ease-in-out infinite';

    // Click to explode
    heart.addEventListener('click', () => {
      heart.classList.add('blast');
      setTimeout(() => heart.remove(), 500);
    });

    heartContainer.appendChild(heart);

    // Remove after animation
    setTimeout(() => heart.remove(), 10000);
  }

  // Continuously create hearts
  setInterval(createHeart, 400);
</script>

</body>
</html>
